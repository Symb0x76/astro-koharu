---
import PageLayout from '../layouts/PageLayout.astro';
import MusicList from '../components/music/MusicList';
import { musicConfig } from '../constants/site-config';

const frontmatter = {
  title: '歌单',
  description: '我喜欢的音乐',
};
---

<PageLayout frontmatter={frontmatter}>
  <MusicList client:load origin={musicConfig.openlistOrigin} path={musicConfig.path} />
</PageLayout>
